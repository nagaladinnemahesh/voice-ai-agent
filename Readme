├── database/
│   ├── db.ts                           ← PostgreSQL connection pool
│   └── appointmentRepository.ts        ← All DB queries
├── memory/
│   ├── session_memory/                 ← Redis session (TTL 30min)
│   └── persistent_memory/             ← Redis patient profile (no TTL)
├── services/
│   ├── speech_to_text/whisperService.ts
│   ├── text_to_speech/openaiTTS.ts
│   └── language_detection/detectLanguage.ts
├── scheduler/
│   └── appointment_engine/             ← booking / conflict / reschedule logic
├── frontend/index.html                 ← Single-file demo UI
├── schema.sql                          ← PostgreSQL schema
